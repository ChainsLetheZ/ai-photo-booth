{
  "name": "ux-ml4-party",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "dev:https": "tsx server.ts --https",
    "models": "node scripts/fetch-mediapipe-models.mjs",
    "test:rules": "tsx tests/interactionEngine.test.ts",
    "lan": "bash scripts/start-https.sh",
    "cert": "node scripts/ensure-https-cert.mjs",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "start": "node dist/server.cjs",
    "start:https": "node dist/server.cjs --https"
  },
  "dependencies": {
    "@google/genai": "^1.34.0",
    "@mediapipe/tasks-vision": "0.10.3",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "firebase": "^12.7.0",
    "qrcode": "1.5.3",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "uuid": "^13.0.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^22.14.0",
    "@vitejs/plugin-react": "^5.0.0",
    "esbuild": "^0.28.0",
    "tsx": "^4.22.4",
    "typescript": "~5.8.2",
    "vite": "^6.2.0"
  }
}
